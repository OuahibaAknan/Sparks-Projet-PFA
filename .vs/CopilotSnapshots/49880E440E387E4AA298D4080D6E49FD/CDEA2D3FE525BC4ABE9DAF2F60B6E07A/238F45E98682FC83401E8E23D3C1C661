        var domains = domainDefs.Select(d => new Domain { Name = d.Name, Description = d.Description }).ToArray();
        db.Domains.AddRange(domains);
        var domainByName = domains.ToDictionary(d => d.Name);

        var siteNames = new[] { "Sochaux, FR", "Mulhouse, FR", "Poissy, FR", "Rüsselsheim, DE", "Turin, IT" };
        var sites = siteNames.Select(n => new Site { Name = n }).ToArray();
        db.Sites.AddRange(sites);
        var siteByName = sites.ToDictionary(s => s.Name);

        await db.SaveChangesAsync();

        // --- Users ------------------------------------------------------------

        var users = new (string First, string Last, string Email, UserRole Role, UserStatus Status, UserAvailability Availability, string Color, DateTime Created, Team? Team)[]
        {
            ("Marcus", "Weber", "marcus.weber@alten.com", UserRole.Generalist, UserStatus.Active, UserAvailability.Available, "#008BD2", new DateTime(2023, 3, 11), generalistTeam),
            ("Sofia", "Reyes", "sofia.reyes@alten.com", UserRole.Generalist, UserStatus.Active, UserAvailability.Away, "#008BD2", new DateTime(2023, 5, 2), generalistTeam),
            ("Isabelle", "Morin", "i.morin@alten.com", UserRole.Specialist, UserStatus.Active, UserAvailability.Available, "#043962", new DateTime(2022, 11, 20), specialistTeam),
            ("Tomasz", "Wiśniewski", "t.wisniewski@alten.com", UserRole.Specialist, UserStatus.Active, UserAvailability.Available, "#043962", new DateTime(2023, 1, 9), specialistTeam),
            ("Marc", "Dubois", "marc.dubois@alten.com", UserRole.Generalist, UserStatus.Inactive, UserAvailability.Away, "#008BD2", new DateTime(2022, 7, 14), generalistTeam),
            ("Amara", "Diallo", "a.diallo@alten.com", UserRole.Admin, UserStatus.Active, UserAvailability.Available, "#7C3AED", new DateTime(2022, 2, 1), null),
            ("Youssef", "El Amrani", "y.elamrani@alten.com", UserRole.TeamLead, UserStatus.Active, UserAvailability.Available, "#B45309", new DateTime(2022, 9, 5), null),
            ("Léa", "Fontaine", "l.fontaine@alten.com", UserRole.Polyvalent, UserStatus.Active, UserAvailability.Available, "#0F766E", new DateTime(2023, 6, 18), generalistTeam),
        };

        var userByFirstName = new Dictionary<string, ApplicationUser>();

        foreach (var u in users)
        {
            var user = new ApplicationUser
            {
                UserName = u.Email,
                Email = u.Email,
                EmailConfirmed = true,
                FirstName = u.First,
                LastName = u.Last,
                Role = u.Role,
                Status = u.Status,
                Availability = u.Availability,
                AvatarColor = u.Color,
                CreatedAt = u.Created,
                TeamId = u.Team?.Id,
            };
            var result = await userManager.CreateAsync(user, "demo1234");
            if (!result.Succeeded)
                throw new Exception($"Failed to seed user {u.Email}: {string.Join(", ", result.Errors.Select(e => e.Description))}");
            await userManager.AddToRoleAsync(user, u.Role.ToString());
            userByFirstName[u.First] = user;
