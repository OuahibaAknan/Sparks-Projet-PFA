    public static async Task SeedAsync(IServiceProvider services)
    {
        var db = services.GetRequiredService<AppDbContext>();
        var userManager = services.GetRequiredService<UserManager<ApplicationUser>>();
        var roleManager = services.GetRequiredService<RoleManager<IdentityRole<Guid>>>();

        await db.Database.MigrateAsync();

        foreach (var role in new[] { "Generalist", "Specialist", "Admin", "TeamLead", "Polyvalent" })
        {
            if (!await roleManager.RoleExistsAsync(role))
                await roleManager.CreateAsync(new IdentityRole<Guid>(role));
        }

        if (await db.Users.AnyAsync()) return; // already seeded

        var rnd = new Random();

        // --- Reference data -------------------------------------------------

        var generalistTeam = new Team { Name = "Generalist Support", Department = "Support" };
        var specialistTeam = new Team { Name = "Specialist Support", Department = "Engineering" };
        db.Teams.AddRange(generalistTeam, specialistTeam);

        var sourceSystems = new[] { new SourceSystem { Name = "AIDE" }, new SourceSystem { Name = "TOOLSUP" } };
        db.SourceSystems.AddRange(sourceSystems);
        var sourceSystemByName = sourceSystems.ToDictionary(s => s.Name);

        var domainDefs = new (string Name, string Description)[]
        {
            ("BOM", "Bill of materials structure and export issues."),
            ("ECR Workflow", "Engineering change request approval workflow."),
            ("CAD Data Sync", "CAD/PLM revision synchronization."),
            ("PLM-ERP Integration", "Teamcenter/SAP integration and batch sync."),
