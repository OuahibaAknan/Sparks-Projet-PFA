        // --- AI data, derived from the generated tickets -----------------------

        GenerateAiData(rnd, db, tickets, domainByName);

        // --- A handful of demo notifications, so the bell isn't empty on first login ---

        GenerateNotifications(rnd, db, tickets, generalistPool, specialistPool);

        await db.SaveChangesAsync();
